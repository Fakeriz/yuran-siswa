# Copy to .env.local for Next.js development. Values below are placeholders.
# Configure real values separately for Cloudflare Pages Preview and Production.

# Supabase server URL and public anon key (never use a service-role key here).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Browser client: same URL and anon key. Set these BEFORE the Pages build;
# Next.js embeds NEXT_PUBLIC_* values into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server secret: required only for admin account creation via Supabase Auth.
# Never expose this key through NEXT_PUBLIC_* or commit its real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server secret: full service-account JSON on ONE line, with literal \n in PEM.
# Store the real JSON as an encrypted Cloudflare Pages secret.
DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"service-account@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"}

# Folder MUST be inside a Google Shared Drive, not a personal My Drive.
# Grant the service account permission to create files in that Shared Drive.
DRIVE_FOLDER_ID=your-shared-drive-folder-id

# Cloudflare Pages build image: matches the supported local Node.js major.
NODE_VERSION=22
